# Set to your machine's LAN IP or LAN DNS name (not localhost)
N8N_HOST=192.168.1.x

# The URL other devices on your local network will use
WEBHOOK_URL=http://192.168.1.x:5678/

# Host timezone
TZ=America/Los_Angeles

# External host port for n8n UI/API
N8N_PORT=5678

# Basic auth for LAN exposure (change before first run)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_now
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_RESTRICT_FILE_ACCESS_TO=/home/node/.n8n-files

# Shitpost bot sidecar + workflow settings
SHITPOST_SERVICE_URL=http://shitpost-worker:8000
SHITPOST_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
SHITPOST_REGISTRY_PATH=/data/repost_registry.sqlite
SHITPOST_SHARED_MEDIA_DIR=/home/node/.n8n-files/shitpost_media
SHITPOST_DOWNLOAD_TIMEOUT_SECONDS=120
SHITPOST_MAX_MEDIA_BYTES=24000000
SHITPOST_RSS_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36

# Web management UI (shitbot-manager container)
SHITBOT_MANAGER_PORT=8080
N8N_URL=http://n8n:5678
N8N_API_KEY=your_n8n_api_key_here
N8N_WORKFLOW_ID=your_workflow_id_here
